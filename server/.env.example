# Port (default 3000)
# PORT=3000

# Secret for signing JWTs. Change this in production!
# JWT_SECRET=your-random-secret-at-least-32-chars

# Owner login (only account). Set these and restart server to create your account on first run.
# Use double quotes if the password contains # or spaces, e.g. OWNER_PASSWORD="my#pass word"
# If you change OWNER_PASSWORD, delete the server/data folder and restart so the account is recreated.
# OWNER_EMAIL=your@email.com
# OWNER_PASSWORD=your-secure-password
