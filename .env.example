# Optional: Formspree form ID for the contact form.
# Create a form at https://formspree.io and paste the form ID here (e.g. xyzabcde).
# If unset, the form will only show a success message and not send anywhere.
# VITE_FORMSPREE_ID=your_form_id_here

# Required for production: at least one analytics provider so visits are recorded and you can see them.
# Umami (privacy-friendly, no cookies): https://umami.is — get website ID from your Umami dashboard.
VITE_UMAMI_WEBSITE_ID=your_website_id
# VITE_UMAMI_SRC=https://analytics.umami.is/script.js

# Or use Google Analytics 4: create a GA4 property and use the Measurement ID (e.g. G-XXXXXXXXXX).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
